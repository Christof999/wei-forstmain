# Firebase Web-Konfiguration
# 1. https://console.firebase.google.com -> Projekt anlegen
# 2. Projekt-Einstellungen -> "Meine Apps" -> Web-App (</>) registrieren
# 3. Die angezeigten Werte hier eintragen und Datei als ".env" speichern
# (Diese Werte sind nicht geheim – sie dürfen im Frontend stehen. Der Schutz
#  läuft über die Firebase Security Rules, siehe FIREBASE_SETUP.md.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
